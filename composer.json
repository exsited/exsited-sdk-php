{
    "name": "exsited/exsited",
    "description": "PHP SDK for the Exsited v4 REST API.",
    "homepage": "https://exsited.mintlify.app",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ashiq Rahman",
            "email": "ashiq@webalive.com.au"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "Exsited\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
